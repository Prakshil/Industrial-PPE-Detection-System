# =========================================================
# Industrial PPE Safety System — .gitignore
# =========================================================

# Python & Build
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
build/
.eggs/
.pytest_cache/

# Virtual Environments
.env
.venv/
venv/
ENV/
env/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Node / Frontend Dependencies & Logs
frontend/node_modules/
frontend/.npm/
*.log
logs/

# SQLite Database & Write-Ahead Logs
events.db*
*.db
*.db-shm
*.db-wal

# Large Datasets (too large for Git)
dataset_6class/
merged_negonly/
merged_three_v2_balanced/
datasets/
data/

# Training Run Artifacts & Cache
runs/
PPE_detection/
wandb/
test_media/

# Runtime Evidence Snapshots
evidence/*.jpg
evidence/*.png
evidence/*.jpeg
!evidence/.gitkeep

# Uploads directory
uploads/temp_*.mp4
uploads/quick_*.mp4
!uploads/.gitkeep
!uploads/*.mp4

# Model Weights: Allow tracked production weights in weights/
*.pt
!weights/*.pt

# Temp files
*.tmp
*.bak

evidence/*.mp4
